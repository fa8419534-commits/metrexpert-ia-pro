# Session & access codes
JWT_SECRET=
METREXPERT_ACCESS_CODE=
METREXPERT_ADMIN_ACCESS_CODE=

# LLM & Storage API (Forge / OpenAI-compatible)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional OAuth & Frontend config
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
